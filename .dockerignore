# The Render build context is the repository root. Never send local state or
# credentials into Docker's build context, even when the Dockerfile is nested.
.git
.github
.venv
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/playwright/.auth
**/browser_profiles
**/browser-profile
**/storageState.json
**/storage-state.json
**/auth.json
**/cookies.json
**/credentials.json
**/*credentials*.json
**/*secrets*.json

# Local secrets and configuration (including example env files; runtime
# configuration belongs in Render's environment settings).
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx

