# BabyStepsAI local development defaults. No API keys are required.
# Real same-browser human verification requires a visible local Chromium window.
BABYSTEPS_BROWSER_HEADLESS=true
BABYSTEPS_ENABLE_SAME_BROWSER_HANDOFF=true
# Optional Groq cloud provider model; API key remains only in your private .env.
# GROQ_MODEL=openai/gpt-oss-20b
