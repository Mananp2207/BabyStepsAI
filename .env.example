# BabyStepsAI local development defaults. No API keys are required.
# Real same-browser human verification requires a visible local Chromium window.
BABYSTEPS_BROWSER_HEADLESS=true
BABYSTEPS_ENABLE_SAME_BROWSER_HANDOFF=true
# Optional Groq cloud provider model; API key remains only in your private .env.
# GROQ_MODEL=openai/gpt-oss-20b

# Public multi-user mode. Example identity provider: Google OIDC.
# Configure client secrets only in the deployment secret store.
# BABYSTEPS_AUTH_MODE=oidc
# BABYSTEPS_DATABASE_URL=postgresql://bsa_runtime.project-ref:secret@pooler-host:5432/postgres?sslmode=require
# BABYSTEPS_MIGRATOR_DATABASE_URL=postgresql://bsa_migrator.project-ref:secret@pooler-host:5432/postgres?sslmode=require
# BABYSTEPS_RUNTIME_DB_ROLE=bsa_runtime
# BABYSTEPS_TENANT_DB_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
# BABYSTEPS_DB_POOL_SIZE=8
# BABYSTEPS_DB_POOL_TIMEOUT=10
# BABYSTEPS_OIDC_ISSUER=https://accounts.google.com
# BABYSTEPS_OIDC_CLIENT_ID=provided-by-identity-provider
# BABYSTEPS_OIDC_CLIENT_SECRET=store-in-secret-manager
# BABYSTEPS_OIDC_REDIRECT_URI=https://your-app.example/auth/callback
# BABYSTEPS_PUBLIC_ORIGIN=https://your-app.example
# BABYSTEPS_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
# Google account recovery is handled by Google; leave BABYSTEPS_OIDC_RECOVERY_URL unset.
# BABYSTEPS_OPERATOR_SUBJECT=verified-operator-subject-for-legacy-claim-approval
# BABYSTEPS_AUTH_DB=/persistent/private/path/babysteps-auth.sqlite3
# BABYSTEPS_DATA_ROOT=/persistent/private/path/user-data
# BABYSTEPS_COOKIE_SECURE=true
# Supabase Storage is server-side only. Never expose the service-role key to the browser.
# Keep local development on BABYSTEPS_STORAGE_BACKEND=local.
# BABYSTEPS_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# Preferred Supabase server key; never expose this to the browser.
# SUPABASE_SECRET_KEY=sb_secret_store-only-in-secret-manager
# Legacy JWT fallback during key migration only.
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-jwt-store-only-in-secret-manager
# SUPABASE_PRIVATE_BUCKET=babysteps-private
# Groq requests are disabled unless the user has applicable cloud-AI consent.
# GROQ_API_KEY=store-only-in-secret-manager
